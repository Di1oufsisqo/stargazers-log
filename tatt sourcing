# app.py
import os, json, requests
from flask import Flask, request
import anthropic

app = Flask(__name__)
claude = anthropic.Anthropic(api_key=os.environ["ANTHROPIC_API_KEY"])

IG_TOKEN   = os.environ["IG_PAGE_ACCESS_TOKEN"]   # from Meta developer app
VERIFY     = os.environ["IG_VERIFY_TOKEN"]        # any secret string you choose
TG_TOKEN   = os.environ["TELEGRAM_BOT_TOKEN"]
TG_CHAT_ID = os.environ["TELEGRAM_CHAT_ID"]

SYSTEM = """You are the booking assistant for a tattoo studio (@wi.llians_inkc_itytattt).
Be friendly and brief. Collect: tattoo idea, size, body placement, colour or black & grey,
budget, preferred date. Give price ranges only from this list: small (under 5cm) KES 3,000-6,000;
medium KES 6,000-15,000; large KES 15,000+. A deposit is required to confirm.
When the client clearly agrees to the price and a date, end your message with a line:
AGREED: {"idea": "...", "size": "...", "placement": "...", "price": "...", "date": "..."}
Never promise anything outside these rules; say the artist will confirm details."""

histories = {}  # use a database (SQLite/Redis) in production

def send_ig(user_id, text):
    requests.post(
        "https://graph.facebook.com/v21.0/me/messages",
        params={"access_token": IG_TOKEN},
        json={"recipient": {"id": user_id}, "message": {"text": text}},
    )

def notify_owner(user_id, deal):
    msg = (f"New tattoo booking agreed!\nIG user id: {user_id}\n"
           + "\n".join(f"{k}: {v}" for k, v in deal.items()))
    requests.post(f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage",
                  json={"chat_id": TG_CHAT_ID, "text": msg})

@app.get("/webhook")
def verify():
    if request.args.get("hub.verify_token") == VERIFY:
        return request.args.get("hub.challenge")
    return "forbidden", 403

@app.post("/webhook")
def incoming():
    data = request.json
    for entry in data.get("entry", []):
        for ev in entry.get("messaging", []):
            if "message" not in ev or ev["message"].get("is_echo"):
                continue
            uid  = ev["sender"]["id"]
            text = ev["message"].get("text", "")
            hist = histories.setdefault(uid, [])
            hist.append({"role": "user", "content": text})

            reply = claude.messages.create(
                model="claude-sonnet-4-6", max_tokens=500,
                system=SYSTEM, messages=hist[-20:]
            ).content[0].text

            hist.append({"role": "assistant", "content": reply})

            if "AGREED:" in reply:
                body, _, js = reply.partition("AGREED:")
                try:
                    notify_owner(uid, json.loads(js.strip()))
                except Exception:
                    notify_owner(uid, {"raw": js.strip()})
                reply = body.strip() or "Great, the artist will confirm shortly!"
            send_ig(uid, reply)
    return "ok"

if __name__ == "__main__":
    app.run(port=5000)
